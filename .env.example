# SADIMEX SALES INTELLIGENCE — Environment Variables
# Instrucciones: Copia este archivo como .env y rellena con tus valores reales.
# NUNCA subas .env a git. Este archivo (.env.example) SÍ se puede versionar.

# --- Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_TRANSCRIPTION=gemini-1.5-pro
GEMINI_MODEL_ANALYSIS=gemini-1.5-flash

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# --- App Config ---
APP_ENV=development
LOG_LEVEL=INFO
TMP_DIR=.tmp

# --- Auth (JWT) ---
JWT_SECRET=your_jwt_secret_here

# --- Ciudades disponibles ---
CIUDADES_ACTIVAS=LPZ,CBBA,SCZ

# =====================================================================
# LECTOR DE GÓNDOLA (servicio aparte en Railway — ver gondola/README.md)
# =====================================================================

# --- OpenRouter (visión) ---
OPENROUTER_API_KEY=your_openrouter_key_here
# Modelo barato por el que pasa toda foto.
MODELO_PRIMARIO=qwen/qwen3-vl-32b-instruct
# Modelo grande, solo cuando el primario reporta baja confianza.
MODELO_ESCALADO=qwen/qwen3-vl-235b-a22b-instruct
# Qué hacer con una lectura poco confiable:
#   consenso — segunda lectura del MISMO modelo barato y se fusionan.
#              Más preciso Y más barato que escalar. Es el default.
#   escalado — reintenta con el modelo grande.
#   ninguna  — se queda con la primera lectura.
ESTRATEGIA_BAJA_CONFIANZA=consenso
# Confianza global por debajo de la cual se verifica. OJO: en pruebas
# reales el modelo se declara 95% seguro incluso cuando inventa huecos,
# así que este umbral casi nunca se dispara solo. Lo que de verdad
# decide son las tres señales de riesgo de abajo.
UMBRAL_ESCALADO=0.75

# Verificar con una segunda lectura cuando la PRIMERA reporta algo que,
# de ser falso, cuesta trabajo humano y credibilidad:
VERIFICAR_SI_HAY_HUECOS=true            # falso quiebre → visita en vano
VERIFICAR_SI_PRECIO_FUERA_RANGO=true    # falsa acusación a la sala
VERIFICAR_SI_FALTA_PRIORITARIO=true     # falsa reposición de urgencia
# Tope de verificaciones por día, como fracción de las fotos.
VERIFICACION_MAX_FRACCION_DIARIA=0.50
# La segunda lectura necesita temperatura: con 0 sería un eco.
TEMPERATURA_VERIFICACION=0.4
# Si las dos lecturas coinciden menos que esto, se escala al modelo
# grande como último recurso. 0 desactiva ese tercer intento.
UMBRAL_ACUERDO_PARA_ESCALAR=0.50
# Confianza mínima para dar un producto por presente en góndola.
UMBRAL_DETECCION=0.60
# Tope de fotos que pueden escalar al modelo grande, como fracción del día.
# Protege la factura cuando entra un lote de fotos malas. 0 = sin escalado.
ESCALADO_MAX_FRACCION_DIARIA=0.20

# --- Storage de fotos ---
SUPABASE_BUCKET=gondola-fotos

# --- Frontend (Vercel) ---
# URL pública del servicio de góndola en Railway. Sin esto la pantalla
# de captura no puede encolar fotos y avisa al reponedor.
VITE_GONDOLA_API_URL=https://tu-servicio.up.railway.app

# --- Worker ---
WORKER_INTERVALO_SEGUNDOS=5
# Fotos en paralelo por réplica. El trabajo es esperar a OpenRouter, no
# calcular, así que escala casi lineal. Medido a 13.6 s por foto:
# 6 en paralelo = 26 fotos/min por réplica (500 fotos en ~19 min).
WORKER_CONCURRENCIA=6
WORKER_MAX_INTENTOS=3

# --- Fiabilidad y latencia ---
# El modelo entra en un bucle degenerado ~1 de cada 3 veces y devuelve
# JSON roto. El reintento sube la temperatura en cada vuelta, que es lo
# que rompe el bucle (con 0 repetiría el mismo fallo).
REINTENTOS_RESPUESTA_INVALIDA=3
# Tope de tokens de salida. La latencia es casi toda generación.
MAX_TOKENS_SALIDA=4000
# Preferencia de proveedor en OpenRouter. Vacío: se midió y no aportó.
PREFERENCIA_PROVEEDOR=

# --- Imagen ---
IMAGEN_MAX_LADO=1600
PACKSHOT_LADO=220
# Tope de packshots en la hoja de referencia. El mosaico viaja en CADA
# foto, así que con catálogos grandes es el costo dominante.
PACKSHOT_MAX_EN_HOJA=24

# --- Anti-fraude ---
# Margen extra sobre el radio de la sala antes de marcar la foto.
GPS_MARGEN_METROS=100
